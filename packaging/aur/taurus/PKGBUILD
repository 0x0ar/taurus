pkgname=taurus
pkgver=1.0.0
pkgrel=1
pkgdesc='A shell for Wayland compositors built on Quickshell'
arch=('x86_64')
url='https://github.com/0x0ar/taurus'
license=('AGPL-3.0-only')
depends=(
    'kitty' 'zbar' 'tesseract' 'tesseract-data-eng'
    'wl-clipboard' 'qt6-multimedia'
    'cliphist' 'jq' 'ddcutil'
    'bluez' 'networkmanager' 'matugen'
    'pipewire' 'wireplumber' 'pipewire-pulse' 'pipewire-alsa' 'libpulse' 'python'
    'imagemagick' 'file'
    'ffmpeg' 'fastfetch' 'quickshell'
    'grim' 'playerctl' 'satty' 'xdg-desktop-portal-gtk' 'power-profiles-daemon'
    'qt6-wayland' 'qt6ct' 'adwaita-icon-theme' 'gpu-screen-recorder'
    'wf-recorder' 'adw-gtk-theme'
    'ttf-iosevka-nerd' 'pambase' 'curl' 'pciutils'
)
optdepends=(
    'hyprland: Hyprland compositor'
    'niri: Niri compositor'
    'sway: Sway compositor'
    'mangowm: Mango compositor'
    'umbriel-git: Umbriel compositor'
    'sddm: Login screen theme'
    'qt6-declarative: Login screen theme'
    'qt6-svg: Login screen theme'
)
conflicts=('quickshell-git')
backup=('etc/pam.d/taurus')
install=taurus.install
_skiver=0.7.1
_audiover=0.4.0
_gammaver=0.7.0
_corever=0.8.1
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "ski-$_skiver-x86_64-linux.tar.gz::https://github.com/ilyamiro/Ski/releases/download/v$_skiver/ski-$_skiver-x86_64-linux.tar.gz"
        "taurus-audio-$_audiover-x86_64-linux.tar.gz::https://github.com/0x0ar/taurus-audio/releases/download/v$_audiover/taurus-audio-$_audiover-x86_64-linux.tar.gz"
        "taurus-gamma-$_gammaver-x86_64-linux.tar.gz::https://github.com/0x0ar/taurus-gamma/releases/download/v$_gammaver/taurus-gamma-$_gammaver-x86_64-linux.tar.gz"
        "taurus-core-$_corever-x86_64-linux.tar.gz::https://github.com/0x0ar/taurus-core/releases/download/v$_corever/taurus-core-$_corever-x86_64-linux.tar.gz")
sha256sums=('e12b51eb88b6fe3a8a86f799e8f9fc32a79fdaf98a402cfd13f11ce1b4ad20bd'
            '512d174ea49e51c7fbac79b315b3a98b3d59ec41ae18d37afe402ee0d2695c7b'
            '6c753220c65739e797062c3779eec4097428500a8a3948195086b457e06cc96b'
            '0af4c6fbce8eabdadcddbdf3d82b591201c90e2d97fa8e6282eace015c9cc2e3'
            'baf985f23f641bfece5927c72ba768ebb9c9319d41de057e3a7569a2ceed4529')

package() {
    cd "$pkgname-$pkgver"

    local share="$pkgdir/usr/share/taurus"

    install -d "$share"
    cp -a bin src config compositors "$share/"
    install -Dm644 version.txt "$share/version.txt"
    printf 'pacman\n' | install -Dm644 /dev/stdin "$share/package-managed"

    chmod 755 "$share"/bin/*
    find "$share/src" -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod 755 {} +

    install -d "$pkgdir/usr/bin"
    ln -s ../share/taurus/bin/taurus "$pkgdir/usr/bin/taurus"
    ln -s ../share/taurus/bin/taurusd "$pkgdir/usr/bin/taurusd"

    install -d "$pkgdir/usr/share/sddm/themes"
    mv "$share/config/sddm/themes/material-you" "$pkgdir/usr/share/sddm/themes/material-you"
    rmdir -p --ignore-fail-on-non-empty "$share/config/sddm/themes"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/sddm/themes/material-you"

    install -Dm644 /dev/stdin "$pkgdir/etc/pam.d/taurus" <<'EOF'
-auth       sufficient   pam_fprintd.so
auth        include      system-auth
account     include      system-auth
EOF

    cp -a "$srcdir/usr/." "$pkgdir/usr/"

    install -Dm644 /dev/stdin "$pkgdir/etc/xdg/xdg-desktop-portal/portals.conf" <<'EOF'
[preferred]
org.freedesktop.impl.portal.FileChooser=ski
EOF

    install -Dm644 /dev/stdin "$pkgdir/etc/xdg/mimeapps.list" <<'EOF'
[Default Applications]
inode/directory=ski.desktop
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/lib/environment.d/50-taurus-portal.conf" <<'EOF'
GTK_USE_PORTAL=1
EOF

    install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
