#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$TAURUS_DIR" ]; then
    export TAURUS_DIR="$(dirname "$BIN_DIR")/src"
fi
TAURUS_PID_FILE="${TAURUS_PID_FILE:-/tmp/taurusd.pid}"
TAURUS_LOCK_FILE="${TAURUS_LOCK_FILE:-/tmp/taurusd.lock}"
export TAURUS_PID_FILE TAURUS_LOCK_FILE

export TAURUS_BUS_ENV=1
source "$TAURUS_DIR/scripts/caching.sh"
source "$TAURUS_DIR/scripts/config.sh"
source "$TAURUS_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$(find "$TAURUS_DIR/quickshell" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
fi

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local stat
    stat=$(<"/proc/$pid/stat") 2>/dev/null || return 1
    [[ "$stat" =~ \)\ Z ]] && return 1
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 20 ))

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null

    while is_alive "$pid"; do
        if [ "$count" -ge "$max_count" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
        sleep 0.05
        ((count++))
    done
}

get_all_children() {
    local target="$1"
    local child
    for child in $(pgrep -P "$target" 2>/dev/null); do
        get_all_children "$child"
        echo "$child"
    done
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/taurus/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^TAURUS_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$TAURUS_VERSION" ]; then
        ver="$TAURUS_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$TAURUS_DIR" ] && [ -f "$TAURUS_DIR/version.txt" ]; then
            ver=$(cat "$TAURUS_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$TAURUS_DIR" ] && [ -f "$(dirname "$TAURUS_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$TAURUS_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

show_help() {
    echo "$(t "daemon.cli.usage")"
    echo ""
    echo "$(t "daemon.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  start                       $(t "daemon.cli.cmd_start")"
    echo "  stop                        $(t "daemon.cli.cmd_stop")"
    echo "  status                      $(t "daemon.cli.cmd_status")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -v, --verbose               $(t "daemon.cli.opt_verbose")"
    echo "  -V, --version               $(t "daemon.cli.opt_version")"
    echo "  -h, --help                  $(t "daemon.cli.opt_help")"
    echo ""
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export TAURUS_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "taurusd v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|status)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
            fi
            shift
            ;;
        *)
            echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    COMMAND="start"
fi

if [ "$COMMAND" == "stop" ]; then
    pid=""
    if [ -f "$TAURUS_PID_FILE" ]; then
        pid="$(cat "$TAURUS_PID_FILE" 2>/dev/null)"
    fi

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 3
    else
        pkill -TERM -f "taurus-core screentime track" 2>/dev/null
        if [ -n "$MAIN_QML" ]; then
            pkill -TERM -f "quickshell.*$MAIN_QML" 2>/dev/null
        fi
        sleep 0.2
    fi

    pkill -KILL -f "taurus-core screentime track" 2>/dev/null
    if [ -n "$MAIN_QML" ]; then
        pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
    fi
    pkill -TERM -f "wl-paste --watch echo 1" 2>/dev/null
    bash "$TAURUS_DIR/scripts/gamma.sh" stop >/dev/null 2>&1
    command -v taurus-core >/dev/null 2>&1 && taurus-core quit >/dev/null 2>&1
    command -v taurus-audio >/dev/null 2>&1 && taurus-audio ctl quit >/dev/null 2>&1

    rm -f "$TAURUS_PID_FILE" 2>/dev/null
    rm -f "$TAURUS_LOCK_FILE" 2>/dev/null
    echo "$(t "daemon.cli.stopped")"
    exit 0
fi

if [ "$COMMAND" == "status" ]; then
    pid=""
    if [ -f "$TAURUS_PID_FILE" ]; then
        pid="$(cat "$TAURUS_PID_FILE" 2>/dev/null)"
    fi
    if [ -n "$pid" ] && is_alive "$pid"; then
        echo "$(t "daemon.cli.status_running" PID="$pid")"
        exit 0
    else
        echo "$(t "daemon.cli.status_stopped")"
        exit 1
    fi
fi

# Hardware decoder for video wallpapers when the NVIDIA driver is loaded.
# FFmpeg's VAAPI (as used by Qt) opens the FIRST render node, so VAAPI is only
# chosen when that node belongs to another GPU (hybrid laptops: decode on the
# iGPU and let the NVIDIA GPU sleep). Otherwise decode on the CPU.
wallpaper_decoder() {
    local drm="${1:-/sys/class/drm}" node
    for node in "$drm"/renderD*; do
        [ -r "$node/device/vendor" ] || continue
        if [ "$(cat "$node/device/vendor")" != "0x10de" ]; then
            echo vaapi
        else
            echo none
        fi
        return
    done
    echo none
}

if [ "$COMMAND" == "start" ]; then
    exec 9>"$TAURUS_LOCK_FILE"

    if ! flock -n 9; then
        existing_pid=""
        [ -f "$TAURUS_PID_FILE" ] && existing_pid="$(cat "$TAURUS_PID_FILE" 2>/dev/null)"

        if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
            echo "$(t "daemon.already_running")"
            exit 1
        fi

        pkill -KILL -f "taurus-core screentime track" 2>/dev/null
        if [ -n "$MAIN_QML" ]; then
            pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
        fi
        sleep 0.2

        if ! flock -n 9; then
            echo "$(t "daemon.already_running")"
            exit 1
        fi
    fi

    echo $$ > "$TAURUS_PID_FILE"

    CLEANUP_DONE=false
    LAUNCH_PID=""
    QS_PID=""
    WATCH_PID=""

    cleanup() {
        if [ "$CLEANUP_DONE" = true ]; then
            return
        fi
        CLEANUP_DONE=true
        trap '' SIGINT SIGTERM SIGHUP

        [ "$VERBOSE" = true ] && echo "$(t "daemon.shutting_down")"

        [ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null
        local group
        for group in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$group" ] && kill -TERM -- "-$group" 2>/dev/null
        done
        pkill -TERM -f "taurus-core screentime track" 2>/dev/null

        local count=0
        while [ "$count" -lt 20 ]; do
            if ! is_alive "$QS_PID" && ! is_alive "$LAUNCH_PID"; then
                break
            fi
            sleep 0.05
            ((count++))
        done

        for group in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$group" ] && kill -KILL -- "-$group" 2>/dev/null
        done
        pkill -KILL -f "taurus-core screentime track" 2>/dev/null
        bash "$TAURUS_DIR/scripts/gamma.sh" stop 9>&- >/dev/null 2>&1
        command -v taurus-core >/dev/null 2>&1 && taurus-core quit 9>&- >/dev/null 2>&1
        command -v taurus-audio >/dev/null 2>&1 && taurus-audio ctl quit 9>&- >/dev/null 2>&1

        exec 9>&- 2>/dev/null
        rm -f "$TAURUS_PID_FILE" 2>/dev/null
        rm -f "$TAURUS_LOCK_FILE" 2>/dev/null
        exit 0
    }

    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    [ "$VERBOSE" = true ] && echo "$(t "daemon.launching")"

    (
        bash "$TAURUS_DIR/scripts/migrate_niri_overview.sh"
        bash "$TAURUS_DIR/scripts/migrate_easyeffects.sh"
        command -v taurus-audio >/dev/null 2>&1 && taurus-audio start
    ) 9>&- >/dev/null 2>&1 &

    setsid bash "$TAURUS_DIR/quickshell/guide/wellbeing/launch_daemon.sh" 9>&- &
    LAUNCH_PID=$!

    # On NVIDIA, keep wallpaper video decoding off the NVIDIA GPU: NVDEC keeps it at
    # full clocks (~+8 W measured on a 1080p loop). Users can still override the variable.
    if [ -d /proc/driver/nvidia ]; then
        export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES-$(wallpaper_decoder)}"
    fi
    # A settings.json that does not parse is the commonest reason the shell never comes up:
    # repair it from the last known good copy (or a backup) before launching.
    python3 -I "$TAURUS_DIR/scripts/doctor.py" preflight 9>&- >/dev/null 2>&1

    # Supervision. Watchers announce a recovery once the shell is up (the shell is the
    # notification server, so nothing can be shown before) and remember known-good settings.
    start_watchers() {
        (
            # sleep in the background and wait, so stopping the watcher also stops its sleep
            nap() { sleep "$1" & NAP_PID=$!; wait "$NAP_PID"; }
            trap '[ -n "$NAP_PID" ] && kill "$NAP_PID" 2>/dev/null; exit 0' TERM
            nap "${TAURUS_WATCH_DELAY:-20}"
            kill -0 "$QS_PID" 2>/dev/null || exit 0
            python3 -I "$TAURUS_DIR/scripts/doctor.py" announce
            nap "${TAURUS_GOOD_AFTER:-70}"
            while kill -0 "$QS_PID" 2>/dev/null; do
                python3 -I "$TAURUS_DIR/scripts/doctor.py" mark-good
                nap 600
            done
        ) 9>&- >/dev/null 2>&1 &
        WATCH_PID=$!
    }
    stop_watchers() {
        [ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null
        WATCH_PID=""
    }
    # The Wayland session is gone: the shell was ended on purpose, not crashed.
    session_alive() {
        [ -z "$WAYLAND_DISPLAY" ] && return 0
        case "$WAYLAND_DISPLAY" in
            /*) [ -S "$WAYLAND_DISPLAY" ] ;;
            *) [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ] ;;
        esac
    }

    RESTART_TIMES=()
    while true; do
        setsid quickshell -p "$MAIN_QML" 9>&- &
        QS_PID=$!
        STARTED_AT=$(date +%s)
        start_watchers

        qs_rc=0
        while kill -0 "$QS_PID" 2>/dev/null; do
            wait "$QS_PID" 2>/dev/null
            qs_rc=$?
        done
        stop_watchers

        # taurus kill / restart and the session ending are signals or a gone socket: leave quietly.
        # A clean exit (status 0) is not a crash either.
        if [ "$qs_rc" -eq 0 ] || ! session_alive; then
            break
        fi
        # On logout the shell can die a moment before the compositor's socket disappears:
        # look again before calling it a crash.
        sleep "${TAURUS_SESSION_GRACE:-2}"
        session_alive || break

        # The crashed shell's helpers (visualizer, workers) live in its process group: end them
        # so the restarted shell does not run next to its predecessor's leftovers.
        kill -TERM -- "-$QS_PID" 2>/dev/null
        sleep 0.3
        kill -KILL -- "-$QS_PID" 2>/dev/null

        now=$(date +%s)
        recent=()
        for t in "${RESTART_TIMES[@]}"; do
            [ $((now - t)) -lt 600 ] && recent+=("$t")
        done
        RESTART_TIMES=("${recent[@]}")
        # Restart at most twice in ten minutes, and never again if a restarted shell died within 20 s.
        if [ "${#RESTART_TIMES[@]}" -ge 2 ] || { [ "${#RESTART_TIMES[@]}" -ge 1 ] && [ $((now - STARTED_AT)) -lt 20 ]; }; then
            python3 -I "$TAURUS_DIR/scripts/doctor.py" gave-up "$qs_rc" 9>&-
            break
        fi
        RESTART_TIMES+=("$now")
        python3 -I "$TAURUS_DIR/scripts/doctor.py" recovered "$qs_rc" 9>&- >/dev/null 2>&1
        [ "$VERBOSE" = true ] && echo "taurus: the shell exited with status $qs_rc; restarting it"
    done
fi
